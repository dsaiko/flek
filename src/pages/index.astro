---
import Layout from '../layouts/Layout.astro';
---
<Layout
  titleCs="Flek! · Mariáš"
  titleEn="Flek! · Mariáš — Czech card game"
  titleDe="Flek! · Mariasch — böhmisches Kartenspiel"
  descriptionCs="Flek! — online mariáš. Pocta hrám FLEK! a RE! od Pivoňka Software (MS-DOS, 1991–93)."
  descriptionEn="Flek! — Mariáš, the classic Czech card game online. A tribute to FLEK! and RE! by Pivoňka Software (MS-DOS, 1991–93)."
  descriptionDe="Flek! — Mariasch, das klassische böhmische Kartenspiel online. Eine Hommage an FLEK! und RE! von Pivoňka Software (MS-DOS, 1991–93)."
>
  <main>
    <section class="hero">
      <p class="kicker">FLEK!.EXE · 1992 → 2026</p>
      <h1>Flek!</h1>
      <p class="lead">
        <span class="cs">Online mariáš — pocta hrám <strong>FLEK!</strong> a <strong>RE!</strong> Ing. Jaroslava Pivoňky
          a <strong>Josefu Saikovi</strong>, učiteli, který miloval matematiku.</span>
        <span class="en">Mariáš, the classic Czech card game — a tribute to <strong>FLEK!</strong> and <strong>RE!</strong> by Ing. Jaroslav Pivoňka,
          and to <strong>Josef Saiko</strong>, a teacher who loved mathematics.</span>
        <span class="de">Mariasch, das klassische böhmische Kartenspiel — eine Hommage an <strong>FLEK!</strong> und <strong>RE!</strong> von Ing. Jaroslav Pivoňka
          und an <strong>Josef Saiko</strong>, einen Lehrer, der die Mathematik liebte.</span>
      </p>
    </section>

    <section id="game-section" class="game-section">
      <div id="table">
        <div class="opp-row">
          <div class="seatbox" id="seat-left">
            <div class="seat-name"></div>
            <div class="backs"></div>
            <div class="seat-ledger"></div>
            <div class="pile" id="pile-left"></div>
            <div class="melds" id="melds-left"></div>
            <div class="bubble"></div>
          </div>
          <div class="center-top">
            <div id="status"></div>
            <div id="contract-info"></div>
          </div>
          <div class="seatbox" id="seat-right">
            <div class="seat-name"></div>
            <div class="backs"></div>
            <div class="seat-ledger"></div>
            <div class="pile" id="pile-right"></div>
            <div class="melds" id="melds-right"></div>
            <div class="bubble"></div>
          </div>
        </div>

        <div id="trick"></div>

        <div id="center-float"></div>

        <div class="me-row">
          <div id="actions"></div>
          <div id="hand"></div>
          <div class="me-meta"><span id="ledger-me"></span></div>
          <div class="pile" id="pile-me"></div>
          <div class="melds" id="melds-me"></div>
          <div class="bubble" id="bubble-me"></div>
        </div>
      </div>

      <div class="game-controls">
        <label>
          <span class="cs">Varianta</span><span class="en">Variant</span><span class="de">Variante</span>
          <select id="set-variant">
            <option value="voleny">Volený (FLEK!)</option>
            <option value="licitovany">Licitovaný (RE!)</option>
          </select>
        </label>
        <label>
          <span class="cs">IQ</span><span class="en">IQ</span>
          <select id="set-difficulty">
            <option value="easy">90</option>
            <option value="normal">110</option>
            <option value="hard">130</option>
          </select>
        </label>
        <label>
          <span class="cs">Vzor karet</span><span class="en">Cards</span><span class="de">Kartenbild</span>
          <select id="set-pattern">
            <option value="history">1860</option>
            <option value="modern">Modern</option>
          </select>
        </label>
        <button id="btn-new" class="ctl-btn"><span class="cs">Nový zápas</span><span class="en">New match</span><span class="de">Neue Partie</span></button>
        <button id="btn-fullscreen" class="ctl-btn" title="Fullscreen">⛶</button>
      </div>
    </section>

    <footer>
      <p>
        <span class="cs">© 2026 Dušan Saiko · nezávislá pocta hrám FLEK! a RE! (Pivoňka Software) ·</span>
        <span class="en">© 2026 Dušan Saiko · an independent tribute to FLEK! and RE! (Pivoňka Software) ·</span>
        <span class="de">© 2026 Dušan Saiko · eine unabhängige Hommage an FLEK! und RE! (Pivoňka Software) ·</span>
        <a href="https://github.com/dsaiko/flek">GitHub</a>
      </p>
      <p class="attribution">
        <span class="cs">Historické karty: jednohlavý pražský vzor, Ant. Kratochvíl, Praha 1860 — public domain
          (Wikimedia Commons / BnF Gallica). Moderní sada: MIT.</span>
        <span class="en">Historical cards: single-headed Prague pattern, Ant. Kratochvíl, Prague 1860 — public domain
          (Wikimedia Commons / BnF Gallica). Modern deck: MIT.</span>
        <span class="de">Historische Karten: einköpfiges Prager Bild, Ant. Kratochvíl, Prag 1860 — gemeinfrei
          (Wikimedia Commons / BnF Gallica). Modernes Blatt: MIT.</span>
      </p>
    </footer>
  </main>
</Layout>

<script src="../scripts/main.ts"></script>

<style is:global>
  :root {
    --table: #24507c;
    --table-light: #2f6499;
    --ink: #1f2430;
    --muted: #6b7280;
    --card-w: clamp(52px, 8.5vw, 92px);
  }
  body {
    margin: 0;
    color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: linear-gradient(160deg, #f6f7f4, #eef1ea);
    min-height: 100vh;
  }
  main { max-width: 1060px; margin: 0 auto; padding: 72px 16px 40px; }

  .hero { text-align: center; margin-bottom: 18px; }
  .kicker {
    font: 600 13px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 3px; color: var(--muted); margin: 0 0 10px;
  }
  .hero h1 { font-size: 44px; margin: 0 0 8px; letter-spacing: -1px; }
  .lead { color: var(--muted); max-width: 620px; margin: 0 auto; font-size: 15px; }

  /* ── stůl ── */
  .game-section { margin: 0 auto; }
  /* fullscreen: nativní i CSS fallback — stůl vyplní celou obrazovku */
  .game-section.fs-fallback {
    position: fixed; inset: 0; z-index: 40; overflow: auto;
  }
  .game-section:fullscreen,
  .game-section.fs-fallback {
    background: #10131a;
    padding: 12px 14px;
    display: flex; flex-direction: column;
    width: 100%; height: 100%;
    --card-w: clamp(60px, 9.5vw, 130px);
  }
  .game-section:fullscreen #table,
  .game-section.fs-fallback #table { flex: 1; }
  .game-section:fullscreen .game-controls,
  .game-section.fs-fallback .game-controls { color: #9aa3ad; }
  #table {
    position: relative;
    border-radius: 20px;
    background: radial-gradient(ellipse at 50% 30%, var(--table-light), var(--table) 75%);
    box-shadow: inset 0 0 60px rgba(0,0,0,.25), 0 10px 30px rgba(17,24,39,.15);
    padding: 14px 14px 10px;
    min-height: 540px;
    display: flex; flex-direction: column;
  }

  .opp-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .seatbox { position: relative; min-width: 140px; }
  .seat-name { color: #e3eefa; font-weight: 700; font-size: 14px; margin-bottom: 4px; }
  .seat-ledger { color: #a9c4dd; font-size: 12px; margin-top: 2px; }
  .backs { display: flex; padding-top: 6px; min-height: calc(var(--card-w) * 1.12); } /* výška rubu — řádek nesmí kolabovat */
  .backs .back { width: calc(var(--card-w) * .62); border-radius: 5px; margin-right: calc(var(--card-w) * -.4);
    box-shadow: 0 2px 6px rgba(0,0,0,.45); }
  .backs .back:last-child { margin-right: 0; }
  #seat-right .backs { justify-content: flex-end; flex-direction: row-reverse; }
  #seat-right .backs .back { margin-right: 0; margin-left: calc(var(--card-w) * -.4); }
  #seat-right { text-align: right; }

  /* pakl vybraných štychů */
  .pile { position: relative; height: calc(var(--card-w) * .55); margin-top: 10px; min-width: calc(var(--card-w) * .8); }
  .pile img {
    position: absolute; width: calc(var(--card-w) * .38); border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0,0,0,.45); top: 0;
  }
  #pile-left img { left: 0; }
  #pile-right img { right: 0; }
  .pile .pile-count {
    position: absolute; top: 50%; transform: translateY(-50%);
    color: #cfe3f5; font-size: 12px; font-weight: 700;
  }
  #pile-left .pile-count { left: calc(var(--card-w) * .8); }
  #pile-right .pile-count { right: calc(var(--card-w) * .8); }
  #pile-me { position: absolute; right: 16px; bottom: 12px; margin: 0; }
  #pile-me img { right: 0; }
  #pile-me .pile-count { right: calc(var(--card-w) * .75); }

  .bubble {
    position: absolute; top: 100%; margin-top: 8px; max-width: 180px;
    background: #fffef5; color: #2b2b33; font-weight: 700; font-size: 14px;
    padding: 7px 12px; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,.3);
    opacity: 0; transform: translateY(-4px); transition: opacity .18s, transform .18s;
    pointer-events: none; z-index: 5;
  }
  #seat-left .bubble { left: 6px; border-top-left-radius: 2px; }
  #seat-right .bubble { right: 6px; border-top-right-radius: 2px; }
  #bubble-me { top: auto; bottom: calc(100% + 8px); left: 50%; margin: 0;
    transform: translate(-50%, 4px); border-bottom-left-radius: 2px; }
  #bubble-me.show { transform: translate(-50%, 0); }
  .bubble.show { opacity: 1; transform: translateY(0); }

  .center-top { text-align: center; flex: 1; }
  #status { color: #eaf2f9; font-size: 15px; min-height: 22px; }
  #status.me-turn { font-weight: 700; color: #ffe9a8; }
  #contract-info { min-height: 24px; margin-top: 6px; }
  #contract-info:not(:empty) {
    display: inline-block; background: #fffdf2; color: #2b2b33;
    font-weight: 700; font-size: 14px; padding: 5px 14px; border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,.35); border: 1px solid #d9d2ba;
  }

  /* štych: karty leží podle sedadel — levý soupeř vlevo, pravý vpravo, já dole */
  #trick {
    flex: 1; position: relative;
    min-height: calc(var(--card-w) * 2.1);
  }
  #trick .played {
    position: absolute; left: 50%; top: 50%;
    width: var(--card-w); border-radius: 6px; box-shadow: 0 4px 14px rgba(0,0,0,.35);
  }
  #trick .played.pos-left  { transform: translate(calc(-50% - var(--card-w) * 1.15), -64%) rotate(-6deg); }
  #trick .played.pos-right { transform: translate(calc(-50% + var(--card-w) * 1.15), -64%) rotate(6deg); }
  #trick .played.pos-me    { transform: translate(-50%, -30%); }

  .me-row { text-align: center; position: relative; padding-bottom: 6px; }
  #actions { min-height: 40px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 8px; }
  /* jednotný styl herních tlačítek: obdélník s oblými rohy (à la FLEK dialogy) */
  .action-btn {
    font: 700 14px/1 inherit; padding: 10px 20px; border-radius: 8px; border: 0;
    background: #eafcf6; color: #0a4a52; cursor: pointer; box-shadow: 0 2px 0 rgba(0,0,0,.25);
  }
  .action-btn.primary { background: #ffd75e; color: #4a3200; }
  .action-btn:disabled { opacity: .45; cursor: default; }
  .action-btn:not(:disabled):hover { filter: brightness(1.04); }

  /* pevná výška ruky — stůl se nesmí zmenšovat s ubývajícími kartami */
  #hand { display: flex; justify-content: center; align-items: flex-end; padding: 10px 0 6px; overflow: visible;
    min-height: calc(var(--card-w) * 1.85); }
  .card-btn {
    background: none; border: 0; padding: 0; cursor: pointer;
    margin: 0 calc(var(--card-w) * -.17);
    transform-origin: 50% 120%;
    filter: drop-shadow(0 3px 8px rgba(0,0,0,.35));
  }
  .card-btn img { width: var(--card-w); border-radius: 6px; display: block; transition: transform .13s; }
  .card-btn:disabled { cursor: default; filter: drop-shadow(0 2px 5px rgba(0,0,0,.3)) grayscale(.35) brightness(.82); }
  .card-btn:not(:disabled):hover { z-index: 3; position: relative; }
  .card-btn:not(:disabled):hover img { transform: translateY(-14px); }
  /* historické skeny: celkově světlejší; nehratelné rozliší jen odbarvení */
  #table.pattern-history .card-btn:disabled { filter: drop-shadow(0 2px 5px rgba(0,0,0,.3)) grayscale(.35); }
  #table.pattern-history .card-btn:disabled img { filter: brightness(1.06); }
  #table.pattern-history .card-btn:not(:disabled) img { filter: brightness(1.14); }
  #table.pattern-history .card-btn:not(:disabled):hover img { filter: brightness(1.22); }
  #table.pattern-history #trick .played { filter: brightness(1.1); }
  .card-btn.selected img { transform: translateY(-18px); outline: 3px solid #ffd75e; border-radius: 6px; }

  /* blokace interakcí během animací */
  #table.animating .card-btn, #table.animating .action-btn { pointer-events: none; }

  /* dohraný štych: zvýraznění vítězné karty a odlet k vítězi */
  #trick .played { transition: transform .42s ease-in, opacity .42s ease-in; }
  #trick .played.win { outline: 3px solid #ffd75e; box-shadow: 0 0 22px rgba(255,215,94,.55); }
  /* box hlášky „20/40" u zahrané karty (po vzoru FLEK!) */
  .meld-box {
    position: absolute; left: 50%; top: 50%;
    background: #fffdf2; color: #2b2b33; border: 1px solid #d9d2ba;
    font: 700 15px/1 inherit; padding: 4px 10px; border-radius: 7px;
    box-shadow: 0 2px 8px rgba(0,0,0,.35); z-index: 4;
  }
  /* box sedí těsně vedle příslušné karty ve štychu */
  .meld-box.meld-left  { transform: translate(calc(-50% - var(--card-w) * 1.95), -64%); }
  .meld-box.meld-right { transform: translate(calc(-50% + var(--card-w) * 1.95), -64%); }
  .meld-box.meld-me    { transform: translate(calc(-50% + var(--card-w) * .95), -20%); }

  /* trvale vystavené hlášky (karta lícem + 20/40) u hráčů — jako ve FLEK! */
  .melds { display: flex; gap: 10px; margin-top: 8px; min-height: calc(var(--card-w) * .62); }
  #seat-right .melds { justify-content: flex-end; }
  .melds .meld { position: relative; }
  .melds .meld img { width: calc(var(--card-w) * .52); border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,.4); display: block; }
  .melds .meld span {
    position: absolute; top: -9px; right: -12px;
    background: #fffdf2; color: #2b2b33; border: 1px solid #d9d2ba;
    font: 700 12px/1 inherit; padding: 2px 6px; border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,.3);
  }
  #melds-me { position: absolute; left: 16px; bottom: 12px; margin: 0; }
  #trick .played.fly-me { transform: translate(calc(-50% + 40vw), 26vh) rotate(10deg) scale(.4); opacity: 0; }
  #trick .played.fly-left { transform: translate(calc(-50% - 42vw), -22vh) rotate(-14deg) scale(.4); opacity: 0; }
  #trick .played.fly-right { transform: translate(calc(-50% + 42vw), -22vh) rotate(14deg) scale(.4); opacity: 0; }

  /* rozdávání po vzoru FLEK!: karty se v ruce objevují postupně */
  .card-btn.reveal, .backs .back.reveal {
    animation-name: card-in;
    animation-duration: 200ms;
    animation-timing-function: ease-out;
    animation-fill-mode: backwards; /* před svým časem je karta skrytá */
  }
  @keyframes card-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  .me-meta { color: #a9c4dd; font-size: 13px; margin-top: 6px; }

  /* zúčtování integrované do stolu (po vzoru FLEK!) — plovoucí vrstva,
     aby obsah neměnil výšku stolu */
  #center-float {
    position: absolute; inset: 0; z-index: 6; display: none;
    align-items: center; justify-content: center; padding: 18px;
    pointer-events: none; /* kliky propadají na tlačítka pod vrstvou */
  }
  #center-float.open { display: flex; }
  #center-float .felt-panel, #center-float .replay { pointer-events: auto; }
  .felt-panel {
    margin: auto; min-width: 340px; max-width: 560px;
    background: #0e7f8b; color: #eafcf6;
    border: 2px solid #0a5a63; border-radius: 12px;
    padding: 14px 22px 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.15);
    font-size: 15px;
  }
  .felt-panel h3 { margin: 0 0 4px; text-align: center; letter-spacing: 1px; }
  .felt-sub { text-align: center; color: #bfeee8; font-size: 13px; margin-bottom: 8px; }
  .felt-panel table { width: 100%; border-collapse: collapse; }
  .felt-panel td { padding: 3px 4px; }
  .felt-panel td.money { text-align: right; font-weight: 700; white-space: nowrap; }
  .felt-panel tr.sum td { border-top: 1px solid rgba(255,255,255,.35); padding-top: 7px; }
  .felt-panel .felt-others { text-align: center; color: #bfeee8; font-size: 12px; margin-top: 8px; }
  /* tlačítka integrovaná do panelu vyúčtování — obdélníky s oblými rohy (à la FLEK dialogy) */
  .felt-panel.warn { border-color: #ffd75e; max-width: 460px; }
  .felt-panel .warn-msg { margin: 6px 0; font-weight: 700; text-align: center; }
  .felt-actions { display: flex; gap: 12px; justify-content: center; margin-top: 14px;
    padding-top: 12px; border-top: 1px solid rgba(255,255,255,.25); }
  .felt-actions .action-btn { flex: 1; max-width: 200px; }
  /* v průběhu hry stejná lišta bez horní linky */
  .replay .felt-actions { border-top: 0; padding-top: 4px; }
  .felt-panel em { opacity: .8; font-style: normal; font-size: 12px; }
  /* symboly barev na tyrkysu zanikají (žalud, list) — bílá podložka */
  .felt-panel svg { background: #fffdf2; border-radius: 5px; padding: 2px 3px;
    box-shadow: 0 1px 3px rgba(0,0,0,.25); }

  /* průběh hry: kaskády štychů + talon */
  .replay { margin: auto; max-height: 100%; overflow: auto; width: 100%; }
  .replay-head { text-align: center; color: #eaf2f9; font-size: 13px; margin: 4px 0 8px; }
  .replay-head img { width: calc(var(--card-w) * .5); border-radius: 4px; vertical-align: middle;
    margin-left: 3px; box-shadow: 0 1px 4px rgba(0,0,0,.4); }
  .rtricks { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: center; }
  .rtrick { text-align: center; }
  .rtrick img { width: calc(var(--card-w) * .58); border-radius: 4px; margin-right: calc(var(--card-w) * -.3);
    box-shadow: 2px 1px 5px rgba(0,0,0,.4); }
  .rtrick img:last-child { margin-right: 0; }
  .rtrick .rwin { color: #cfe3f5; font-size: 11px; margin-top: 3px; }

  .game-controls {
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: center;
    padding: 12px 4px;
    color: var(--muted); font-size: 13px;
  }
  .game-controls label { display: inline-flex; align-items: center; gap: 6px; }
  .game-controls select, .ctl-btn {
    font: 500 13px/1.2 inherit; padding: 6px 10px; border-radius: 8px;
    border: 1px solid #d5d3c8; background: #fff; color: var(--ink); cursor: pointer;
  }
  .ctl-btn:hover { background: #f7f5ec; }

  footer { text-align: center; color: var(--muted); font-size: 13px; margin-top: 26px; }
  footer a { color: inherit; }
  footer .attribution { font-size: 11px; opacity: .8; }

  @media (prefers-reduced-motion: reduce) {
    .card-btn, .bubble, .action-btn { transition: none; }
  }
  @media (max-width: 640px) {
    main { padding-top: 64px; }
    .hero h1 { font-size: 32px; }
    .seatbox { min-width: 90px; }
    #table { min-height: 480px; }
  }
</style>
