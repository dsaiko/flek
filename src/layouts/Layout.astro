---
interface Props {
  titleCs: string;
  titleEn: string;
  titleDe: string;
  titleFr: string;
  descriptionCs: string;
  descriptionEn: string;
  descriptionDe: string;
  descriptionFr: string;
}

const { titleCs, titleEn, titleDe, titleFr, descriptionCs, descriptionEn, descriptionDe, descriptionFr } = Astro.props;
const GOATCOUNTER = 'https://flek.goatcounter.com/count';
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <!--
    CSP: statická stránka bez backendu, takže politika žije v <meta> (musí být
    hned za charset, platí až od svého výskytu). Skripty jen z vlastního
    původu + gc.zgo.at (analytika); beacon GoatCounteru chodí jako <img> na
    NÁŠ konkrétní subdomain (goatcounter je self-service, zástupné
    *.goatcounter.com by povolilo i cizí).

    'unsafe-inline' tady platí jen pro `astro dev`: `npm run build` ho
    post-build krokem (scripts/csp.ts) vymění za sha256 hashe skutečných
    inline bloků, takže v produkci `script-src` opravdu něco brání.
  -->
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://flek.goatcounter.com; connect-src 'self' https://flek.goatcounter.com; worker-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={descriptionCs} />
  <meta name="theme-color" content="#1e5c38" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={new URL('/', Astro.site)} />
  <script is:inline>
    (function(){var l='cs';try{var q=(location.search.match(/[?&]lang=(cs|en|de|fr)/)||[])[1];
     var st=localStorage.getItem('lang');
     if(q)l=q;else if(st==='en'||st==='de'||st==='fr')l=st;}catch(e){}
     window.__lang=l;document.documentElement.classList.add('lang-'+l);})();
  </script>
  <title>{titleCs}</title>
  <style is:global>
    * { box-sizing: border-box; }
    .lang-cs .en, .lang-cs .de, .lang-cs .fr,
    .lang-en .cs, .lang-en .de, .lang-en .fr,
    .lang-de .cs, .lang-de .en, .lang-de .fr,
    .lang-fr .cs, .lang-fr .en, .lang-fr .de { display: none; }

    .home-link {
      position: fixed; top: 18px; z-index: 30;
      background: rgba(255,255,255,.94); border: 1px solid #e5e7eb;
      box-shadow: 0 2px 10px rgba(17,24,39,.08); backdrop-filter: blur(10px);
    }
    .home-link {
      left: 18px; display: inline-flex; align-items: center; gap: 7px;
      color: #374151; border-radius: 999px; padding: 8px 16px;
      font: 600 14px/1.2 system-ui, sans-serif; text-decoration: none;
    }
    .home-link:hover { background: #f9fafb; }
    .home-link .arrow { transition: transform .12s; }
    .home-link:hover .arrow { transform: translateX(-3px); }

  </style>
</head>
<body data-title-cs={titleCs} data-title-en={titleEn} data-title-de={titleDe} data-title-fr={titleFr} data-description-cs={descriptionCs} data-description-en={descriptionEn} data-description-de={descriptionDe} data-description-fr={descriptionFr}>
  <a class="home-link" href="https://www.saiko.cz/"><span class="arrow">←</span><span class="cs">PROJEKTY</span><span class="en">PROJECTS</span><span class="de">PROJEKTE</span></a>

  <slot />

  <script is:inline>
    (function(){
      var d=document.body.dataset;
      var TITLES={cs:d.titleCs,en:d.titleEn,de:d.titleDe,fr:d.titleFr},DESCRIPTIONS={cs:d.descriptionCs,en:d.descriptionEn,de:d.descriptionDe,fr:d.descriptionFr};
      function apply(l){
        document.documentElement.classList.remove('lang-cs','lang-en','lang-de','lang-fr');
        document.documentElement.classList.add('lang-'+l);document.documentElement.lang=l;
        document.title=TITLES[l]||TITLES.cs;
        var meta=document.querySelector('meta[name="description"]');
        if(meta)meta.setAttribute('content',DESCRIPTIONS[l]||DESCRIPTIONS.cs);
        document.querySelectorAll('.langpill button').forEach(function(b){b.classList.toggle('on',b.dataset.lang===l);});
        try{localStorage.setItem('lang',l);}catch(e){} window.__lang=l;
      }
      document.querySelectorAll('.langpill button').forEach(function(b){b.addEventListener('click',function(){apply(b.dataset.lang);});});
      apply(window.__lang||'cs');
    })();
  </script>

  <!--
    Verzovaná URL (count.v4.js je neměnná) + SRI: kdyby někdo podvrhl gc.zgo.at,
    prohlížeč skript neprovede. Při přechodu na v5 je nutné přepočítat hash:
    openssl dgst -sha384 -binary count.v5.js | openssl base64 -A
  -->
  {GOATCOUNTER && (
    <script
      is:inline
      async
      src="https://gc.zgo.at/count.v4.js"
      integrity="sha384-nRw6qfbWyJha9LhsOtSb2YJDyZdKvvCFh0fJYlkquSFjUxp9FVNugbfy8q1jdxI+"
      crossorigin="anonymous"
      referrerpolicy="no-referrer-when-downgrade"
      data-goatcounter={GOATCOUNTER}
    ></script>
  )}
</body>
</html>
